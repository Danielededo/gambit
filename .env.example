# Gambit server configuration. Copy to .env for local use, or set these as
# environment variables on your host. All are optional; defaults shown.

# HTTP/WebSocket port.
PORT=8080

# Global cap on concurrent online games.
MAX_ACTIVE_GAMES=20

# Live games a single client (IP) may own at once.
MAX_GAMES_PER_IP=3

# Concurrent WebSocket connections allowed per IP.
MAX_CONNECTIONS_PER_IP=20

# Failed PIN joins per IP per minute before a short lockout (anti brute-force).
JOIN_FAILURE_LIMIT=10

# Comma-separated origins allowed to open control WebSockets. Leave empty to
# allow same-origin requests (recommended for a single-origin deployment).
# Example: ALLOWED_ORIGINS=https://gambit.example.com
ALLOWED_ORIGINS=

# IMPORTANT: set to 1 when running behind a proxy/load balancer (Render, Fly,
# Railway, etc.) so the real client IP is read from X-Forwarded-For. Without
# this, every player appears to share the proxy's IP and the per-IP limits
# would apply to everyone at once.
TRUST_PROXY=0
